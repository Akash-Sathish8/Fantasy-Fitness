<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the build-generated Info.plist. Registers fantasyfitness:// so
	     Supabase email confirmation links open the app, and explains the camera
	     (Tavern: snap a meal for the plate reader). -->
	<key>NSCameraUsageDescription</key>
	<string>Snap your meal so the Tavern can list what's on the plate. Photos are sent to Anthropic's Claude to be read; Fantasy Fitness doesn't keep them.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.appteamcarolina.Fantasy-Fitness.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fantasyfitness</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
